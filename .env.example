APP_ENV=local
APP_NAME=Admissions AI Reviewer API
APP_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional staff invitation email delivery (disabled unless requested in People).
PUBLIC_APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EXPOSE_LEGACY_API=true
FRONTEND_DIST_PATH=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=admissions-raw
LLAMA_CLOUD_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_FREE_TIER=false
LOCAL_STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=10485760
DOCUMENT_EXTRACTION_BACKEND=mock
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=120
DOCUMENT_CLASSIFICATION_BACKEND=mock
CLASSIFICATION_TEXT_MAX_CHARS=6000
CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.65
RULE_BASED_CLASSIFICATION_MIN_CONFIDENCE=0.88
STRUCTURED_EXTRACTION_BACKEND=mock
STRUCTURED_EXTRACTION_TEXT_MAX_CHARS=12000
DOCUMENT_SUMMARIZATION_BACKEND=mock
DOCUMENT_SUMMARY_TEXT_MAX_CHARS=12000
DOCUMENT_SUMMARY_LOW_CONFIDENCE_THRESHOLD=0.5
RUBRIC_SCORING_BACKEND=mock
RUBRIC_SCORING_TEXT_MAX_CHARS=16000
RUBRIC_SCORING_LOW_CONFIDENCE_THRESHOLD=0.65
PARSER_MODE=mock
INTAKE_MOCK_PROCESSING_DELAY_SECONDS=0.15
INTAKE_WORKER_ENABLED=true
# Keep zero for a single-process deployment so idle SQL can auto-pause.
INTAKE_QUEUE_WATCHDOG_SECONDS=0
DEV_AUTH_ENABLED=true
DEV_AUTH_DEFAULT_ACTOR=dev-local-reviewer
DEV_AUTH_DEFAULT_ROLE=admissions_reviewer
PII_REDACTION_BACKEND=none
AUTO_CREATE_DB_SCHEMA=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

DATABASE_URL=sqlite:///./admissions_ai.db
# Render/Supabase uses a private schema; leave blank for local SQLite/Azure SQL.
DATABASE_SCHEMA=

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_DOCUMENTS=admissions-raw
AZURE_STORAGE_CONNECTION_STRING=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CLASSIFICATION_MODEL_DEPLOYMENT=
AZURE_OPENAI_STRUCTURED_EXTRACTION_MODEL_DEPLOYMENT=
AZURE_OPENAI_SUMMARIZATION_MODEL_DEPLOYMENT=
AZURE_OPENAI_RUBRIC_SCORING_MODEL_DEPLOYMENT=
AZURE_OPENAI_REVIEW_MODEL_DEPLOYMENT=

AZURE_AI_AGENT_DOCUMENT_CLASSIFICATION_NAME=
AZURE_AI_AGENT_DOCUMENT_CLASSIFICATION_VERSION=
AZURE_AI_AGENT_DOCUMENT_CLASSIFICATION_MODEL=

AZURE_AI_AGENT_TRANSCRIPT_EXTRACTION_NAME=
AZURE_AI_AGENT_TRANSCRIPT_EXTRACTION_VERSION=
AZURE_AI_AGENT_TRANSCRIPT_EXTRACTION_MODEL=

AZURE_AI_AGENT_RECOMMENDATION_EXTRACTION_NAME=
AZURE_AI_AGENT_RECOMMENDATION_EXTRACTION_VERSION=
AZURE_AI_AGENT_RECOMMENDATION_EXTRACTION_MODEL=

AZURE_AI_AGENT_ESSAY_EXTRACTION_NAME=
AZURE_AI_AGENT_ESSAY_EXTRACTION_VERSION=
AZURE_AI_AGENT_ESSAY_EXTRACTION_MODEL=

REQUIRE_HUMAN_FINAL_DECISION=true
AI_DECISION_SUPPORT_ONLY=true
